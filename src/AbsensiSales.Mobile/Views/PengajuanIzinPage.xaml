<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.PengajuanIzinPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:PengajuanIzinViewModel"
    Title="Pengajuan Izin"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,24" Spacing="0">

                <controls:BackButton Margin="0,0,0,12" />

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <Label Grid.Column="0" Text="Ajukan permohonan" Style="{StaticResource TitleLabel}" />
                    <Label Grid.Column="1" Text="HR APPROVAL" Style="{StaticResource BadgeNavy}" VerticalOptions="Center" />
                </Grid>
                <Label Text="Pengajuan cuti atau izin sakit akan diteruskan ke HR untuk disetujui." Style="{StaticResource SubtitleLabel}" Margin="0,0,0,16" />

                <controls:SolidCard Tone="White" Padding="20,22">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Jenis permohonan" FontFamily="OpenSansSemibold" FontSize="12" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Grid.Column="0" BackgroundColor="{StaticResource Yellow}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0,12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Jenis}" Value="Izin Sakit">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceAlt}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Cuti" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontFamily="OpenSansSemibold" FontSize="13" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PilihCutiCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceAlt}" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="0,12">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Jenis}" Value="Izin Sakit">
                                        <Setter Property="BackgroundColor" Value="{StaticResource Yellow}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Text="Izin Sakit" HorizontalOptions="Center" TextColor="{StaticResource Navy}" FontFamily="OpenSansSemibold" FontSize="13" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PilihSakitCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>

                        <Label Text="Tanggal mulai" FontFamily="OpenSansSemibold" FontSize="12" Margin="0,4,0,0" />
                        <DatePicker Date="{Binding TanggalMulai}" />

                        <Label Text="Tanggal selesai" FontFamily="OpenSansSemibold" FontSize="12" Margin="0,4,0,0" />
                        <DatePicker Date="{Binding TanggalSelesai}" />

                        <Label Text="Alasan" FontFamily="OpenSansSemibold" FontSize="12" Margin="0,4,0,0" />
                        <controls:SolidCard Tone="Yellow" Padding="12" MinimumHeightRequest="90" StrokeShape="RoundRectangle 14">
                            <Editor Text="{Binding Alasan}" Placeholder="Tuliskan alasan permohonan..." AutoSize="TextChanges" />
                        </controls:SolidCard>

                        <Label Text="Lampiran surat / bukti (opsional)" FontFamily="OpenSansSemibold" FontSize="12" Margin="0,4,0,0" />
                        <controls:SolidCard Tone="Yellow" Padding="12,0" StrokeShape="RoundRectangle 14">
                            <Entry Text="{Binding Lampiran}" Placeholder="Nama file surat/dokter" />
                        </controls:SolidCard>

                    </VerticalStackLayout>
                </controls:SolidCard>

                <Button Text="Kirim permohonan" Style="{StaticResource PrimaryButton}" Command="{Binding KirimCommand}" Margin="0,16,0,8" AutomationId="ButtonKirimIzin" />
                <Button Text="Batal" Style="{StaticResource GhostButton}" Command="{Binding BatalCommand}" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:NotificationHost />
    </Grid>
</ContentPage>


