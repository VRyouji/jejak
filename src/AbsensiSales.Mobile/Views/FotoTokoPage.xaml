<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AbsensiSales.Mobile.Views.FotoTokoPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:AbsensiSales.Mobile.Controls"
    xmlns:vm="clr-namespace:AbsensiSales.Mobile.ViewModels"
    x:DataType="vm:FotoTokoViewModel"
    Title="Foto Toko"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,20,20,24" Spacing="0">

                <controls:BackButton Margin="0,0,0,12" />

                <Label Text="Foto dengan toko" Style="{StaticResource TitleLabel}" Margin="0,0,0,6" />
                <Label Text="{Binding LabelToko}" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,16" />

                <!-- Pratinjau foto / keadaan belum ada foto -->
                <Border Padding="0" HeightRequest="300" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B3B3B" Offset="0" />
                            <GradientStop Color="#D6D6D6" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Label
                            Text="Belum ada foto yang di upload"
                            TextColor="{StaticResource White}"
                            FontFamily="OpenSansSemibold"
                            FontSize="14"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding AdaFoto, Converter={StaticResource InvertedBoolConverter}}">
                            <Label.Shadow>
                                <Shadow Brush="#000000" Opacity="0.35" Radius="10" Offset="0,2" />
                            </Label.Shadow>
                        </Label>

                        <Image
                            Source="{Binding PratinjauFoto}"
                            Aspect="AspectFill"
                            IsVisible="{Binding AdaFoto}" />
                    </Grid>
                </Border>

                <!-- Tombol kamera -->
                <Border
                    Margin="0,20,0,0"
                    BackgroundColor="{StaticResource Yellow}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 35"
                    WidthRequest="70"
                    HeightRequest="70"
                    HorizontalOptions="Center"
                    AutomationId="ButtonAmbilFoto">
                    <Border.Shadow>
                        <Shadow Brush="#10243D" Opacity="0.22" Radius="12" Offset="0,6" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AmbilFotoCommand}" />
                    </Border.GestureRecognizers>

                    <Grid WidthRequest="34" HeightRequest="30" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                        <Border
                            BackgroundColor="{StaticResource Navy}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 2"
                            WidthRequest="12"
                            HeightRequest="9"
                            HorizontalOptions="Center"
                            VerticalOptions="Start" />
                        <Border
                            BackgroundColor="{StaticResource Navy}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 5"
                            WidthRequest="34"
                            HeightRequest="22"
                            HorizontalOptions="Center"
                            VerticalOptions="End" />
                        <Border
                            BackgroundColor="{StaticResource Yellow}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 7"
                            WidthRequest="14"
                            HeightRequest="14"
                            Margin="0,0,0,4"
                            HorizontalOptions="Center"
                            VerticalOptions="End" />
                    </Grid>
                </Border>

                <Label
                    Text="Pastikan wajah dan tampak toko terlihat."
                    Style="{StaticResource SubtitleLabel}"
                    HorizontalTextAlignment="Center"
                    Margin="0,14,0,20" />

                <Button Text="Gunakan foto &amp; tinjau data" Style="{StaticResource PrimaryButton}" Command="{Binding GunakanFotoCommand}" AutomationId="ButtonGunakanFoto" />

            </VerticalStackLayout>
        </ScrollView>

        <controls:NotificationHost />
    </Grid>
</ContentPage>
