<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AbsensiSales.Mobile.Controls.BackButton"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HorizontalOptions="Start">

    <!-- Tombol kembali kecil di kiri atas halaman. -->
    <ImageButton
        AutomationId="BackButton"
        Source="back_chevron.png"
        BackgroundColor="{StaticResource Navy}"
        CornerRadius="11"
        WidthRequest="36"
        HeightRequest="36"
        Padding="10"
        Clicked="OnClicked"
        SemanticProperties.Description="Kembali" />
</ContentView>
